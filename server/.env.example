PORT=5000
# Local Mongo by default; for a shared team backend, use a MongoDB Atlas connection string instead
# (mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wdp301_racehorse) — see DEPLOYMENT.md.
MONGO_URI=mongodb://127.0.0.1:27017/wdp301_racehorse
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS + Socket.io), e.g.
# "http://localhost:5173,https://your-frontend.vercel.app"
CLIENT_URL=http://localhost:5173
ENABLE_SENSOR_SIMULATOR=true
